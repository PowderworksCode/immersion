{
  "$schema": "https://json.schemastore.org/tsconfig",
  // The compiler options are fleet policy and live in tsconfig.base.json,
  // which conf writes here. Only what this repository needs on top belongs
  // below.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // The build scripts are Bun programs (Bun.build, Bun.file); the shims are
    // browser code that the base already gives DOM to.
    "types": ["bun"],
    "noImplicitOverride": true
  },
  // The client shims and the scripts that compile and vendor them. Everything
  // under immersion/vendor is third-party output, and immersion/src is the
  // generated JavaScript the crate embeds.
  "include": ["immersion/ts/**/*.ts", "scripts/**/*.ts"]
}
